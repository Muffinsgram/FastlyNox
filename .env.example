VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
# Set this to your canonical Vercel/custom domain before production deployment.
VITE_PUBLIC_APP_URL=https://fastlynox.vercel.app
VITE_LIVEKIT_URL=wss://your-livekit-host
VITE_LIVEKIT_API_KEY=your-livekit-api-key
# Server only. Never add the VITE_ prefix to this secret.
LIVEKIT_API_SECRET=your-livekit-api-secret
# Public client-side GIPHY key; needed for GIF search and picker results.
VITE_GIPHY_API_KEY=your-giphy-api-key
